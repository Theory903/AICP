{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicp.ai/schemas/vision-capability.schema.json",
  "title": "Vision Capability",
  "description": "Vision capability definition for AICP",
  "type": "object",
  "required": ["name", "provider", "model"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^vision\\.",
      "description": "Capability name must start with 'vision.'"
    },
    "provider": {
      "type": "string",
      "enum": ["paddleocr", "flux2_dev"],
      "description": "Vision provider"
    },
    "model": {
      "type": "string",
      "description": "Model identifier"
    },
    "config": {
      "type": "object",
      "description": "Provider-specific configuration"
    }
  }
}
