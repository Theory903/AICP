{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicp.ai/schemas/llm-capability.schema.json",
  "title": "LLM Capability",
  "description": "Large Language Model capability definition for AICP",
  "type": "object",
  "required": ["name", "provider", "model"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^llm\\.",
      "description": "Capability name must start with 'llm.'"
    },
    "provider": {
      "type": "string",
      "enum": ["gemma", "indic_gemma", "openai", "anthropic"],
      "description": "LLM provider"
    },
    "model": {
      "type": "string",
      "description": "Model identifier"
    },
    "config": {
      "type": "object",
      "description": "Provider-specific configuration"
    }
  }
}
