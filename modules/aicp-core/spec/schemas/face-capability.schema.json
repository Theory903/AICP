{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicp.ai/schemas/face-capability.schema.json",
  "title": "Face Capability",
  "description": "Face recognition capability definition for AICP",
  "type": "object",
  "required": ["name", "provider", "model"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^face\\.",
      "description": "Capability name must start with 'face.'"
    },
    "provider": {
      "type": "string",
      "enum": ["compreface"],
      "description": "Face recognition provider"
    },
    "model": {
      "type": "string",
      "description": "Model identifier"
    },
    "config": {
      "type": "object",
      "description": "Provider-specific configuration"
    }
  }
}
