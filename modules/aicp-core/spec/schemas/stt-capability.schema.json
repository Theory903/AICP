{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicp.ai/schemas/stt-capability.schema.json",
  "title": "STT Capability",
  "description": "Speech-to-Text capability definition for AICP",
  "type": "object",
  "required": ["name", "provider", "model"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^stt\\.",
      "description": "Capability name must start with 'stt.'"
    },
    "provider": {
      "type": "string",
      "enum": ["deepgram", "openai_whisper", "elevenlabs", "local_whisper", "faster_whisper"],
      "description": "STT provider"
    },
    "model": {
      "type": "string",
      "description": "Model identifier"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Default language code"
    },
    "config": {
      "type": "object",
      "properties": {
        "punctuate": {"type": "boolean", "default": true},
        "format": {"type": "boolean", "default": true},
        "diarize": {"type": "boolean", "default": false},
        "temperature": {"type": "number", "minimum": 0, "maximum": 1},
        "compression": {"type": "string", "enum": ["none", "mp3", "opus"]}
      }
    }
  }
}