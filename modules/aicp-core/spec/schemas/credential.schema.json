{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/credential.json",
  "title": "AICP Encrypted Credential",
  "description": "Encrypted credential envelope using a DEK wrapped by a KEK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "encrypted_dek",
    "kek_id",
    "iv",
    "tag",
    "ciphertext"
  ],
  "properties": {
    "encrypted_dek": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1
    },
    "kek_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the KEK used to wrap the credential DEK."
    },
    "iv": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1,
      "description": "AES-GCM nonce used for credential encryption."
    },
    "tag": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1,
      "description": "AES-GCM authentication tag for the encrypted credential payload."
    },
    "ciphertext": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1,
      "description": "Encrypted credential payload."
    }
  }
}
