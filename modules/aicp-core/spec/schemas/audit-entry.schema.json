{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/audit-entry.json",
  "title": "AICP Audit Entry",
  "description": "Immutable log entry for capability execution, policy evaluation, and approval events. Provides traceability for compliance and debugging.",
  "type": "object",
  "required": ["id", "timestamp", "event_type", "actor"],
  "properties": {
    "id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "enum": ["execution_request", "policy_decision", "execution_start", "execution_complete", "execution_error", "approval_request_created", "approval_decision_made", "workflow_created", "workflow_step_start", "workflow_step_complete", "workflow_completed", "session_start", "session_end"]},
    "event_version": {"type": "string"},
    "actor": {"type": "string"},
    "actor_context": {"type": "object", "properties": {"user_id": {"type": "string"}, "agent_id": {"type": "string"}, "session_id": {"type": "string"}, "ip_address": {"type": "string"}, "user_agent": {"type": "string"}}},
    "capability_name": {"type": "string"},
    "capability_kind": {"type": "string", "enum": ["query", "action", "workflow", "async_action", "batch_action"]},
    "arguments": {"type": "object"},
    "arguments_redacted": {"type": "boolean", "default": false},
    "execution_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "step_id": {"type": "string"},
    "policy_decision": {"type": "object", "properties": {"policy_name": {"type": "string"}, "effect": {"type": "string", "enum": ["allow", "deny", "ask", "limit"]}, "reason": {"type": "string"}, "conditions_matched": {"type": "object"}}},
    "approval_request_id": {"type": "string"},
    "approval_decision_id": {"type": "string"},
    "result": {"type": "object", "properties": {"status": {"type": "string", "enum": ["success", "failure", "timeout", "rate_limited", "unavailable"]}, "error_code": {"type": "string"}, "error_message": {"type": "string"}, "execution_time_ms": {"type": "number"}}},
    "duration_ms": {"type": "number"},
    "status": {"type": "string", "enum": ["success", "failure", "pending"]},
    "error_details": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "stack_trace": {"type": "string"}}},
    "metadata": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "correlation_id": {"type": "string"},
    "causation_id": {"type": "string"}
  }
}
