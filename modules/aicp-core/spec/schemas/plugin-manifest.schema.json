{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/plugin-manifest.json",
  "title": "AICP Plugin Manifest",
  "description": "Manifest for an AICP plugin. Provides metadata, lifecycle configuration, and capability/hook declarations.",
  "type": "object",
  "required": ["id", "kind", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique plugin identifier (e.g., 'memory-lancedb', 'approval-hooks-custom')",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["capability_source", "workflow_plugin", "approval_plugin", "policy_plugin", "perception_plugin", "learning_plugin", "generic"],
      "description": "The type of plugin determining its role in AICP architecture"
    },
    "name": {
      "type": "string",
      "description": "Human-readable plugin name"
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g., '1.0.0', '2.3.4-beta')",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what the plugin does"
    },
    "author": {
      "type": "string",
      "description": "Plugin author or organization"
    },
    "license": {
      "type": "string",
      "description": "License identifier (e.g., 'Apache-2.0', 'MIT')"
    },
    "repository": {
      "type": "string",
      "description": "Repository URL for the plugin source code"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Categorization tags for discovery"
    },
    "requirements": {
      "type": "object",
      "description": "System and runtime requirements",
      "properties": {
        "aicp_version_min": {
          "type": "string",
          "description": "Minimum AICP version required (e.g., '1.0.0')"
        },
        "aicp_version_max": {
          "type": "string",
          "description": "Maximum compatible AICP version (exclusive upper bound)"
        },
        "python_version_min": {
          "type": "string",
          "description": "Minimum Python version (e.g., '3.11')"
        },
        "dependencies": {
          "type": "object",
          "description": "External package dependencies with version constraints",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "description": "JSON Schema for plugin configuration",
      "properties": {
        "type": { "type": "string" },
        "properties": { "type": "object" },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ui_hints": {
      "type": "object",
      "description": "UI rendering hints for plugin configuration",
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "field_order": {
          "type": "array",
          "items": { "type": "string" }
        },
        "field_hints": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "description": { "type": "string" },
              "input_type": { "type": "string", "enum": ["text", "password", "number", "select", "textarea", "checkbox"] },
              "placeholder": { "type": "string" },
              "validation_hint": { "type": "string" }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "description": "Plugin lifecycle configuration",
      "properties": {
        "auto_enable": {
          "type": "boolean",
          "default": false,
          "description": "Enable plugin automatically when other requirements are met"
        },
        "auto_enable_when_configured": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Auto-enable if these provider names are configured in AICP"
        },
        "lazy_load": {
          "type": "boolean",
          "default": true,
          "description": "Defer runtime loading until first use"
        },
        "isolation_mode": {
          "type": "string",
          "enum": ["main", "sandbox"],
          "default": "sandbox",
          "description": "Execution isolation: main (unrestricted) or sandbox (containerized)"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Capabilities owned and exported by this plugin",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Capability name (e.g., 'memory.store', 'approval.override')"
          },
          "kind": {
            "type": "string",
            "enum": ["query", "action", "workflow", "async_action", "batch_action"]
          },
          "description": { "type": "string" }
        },
        "required": ["name", "kind"]
      }
    },
    "hooks": {
      "type": "array",
      "description": "Lifecycle hooks registered by this plugin",
      "items": {
        "type": "string",
        "enum": [
          "on_plugin_initialize",
          "on_plugin_shutdown",
          "on_capability_execute_before",
          "on_capability_execute_after",
          "on_approval_request",
          "on_approval_decision",
          "on_policy_evaluate_before",
          "on_policy_evaluate_after",
          "on_workflow_step_before",
          "on_workflow_step_after",
          "on_perception_event",
          "on_signal_ingestion",
          "on_learning_event"
        ]
      }
    },
    "contracts": {
      "type": "object",
      "description": "Ownership claims for protocol extensions",
      "properties": {
        "capability_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Capabilities claimed as plugin-owned"
        },
        "workflow_templates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Workflow templates provided by plugin"
        },
        "policy_sets": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Policy sets provided by plugin"
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Permission boundaries and trust declarations",
      "properties": {
        "access_level": {
          "type": "string",
          "enum": ["unrestricted", "scoped", "minimal"],
          "default": "minimal",
          "description": "Data and system access level"
        },
        "requires_approval": {
          "type": "boolean",
          "default": false,
          "description": "Plugin initialization requires manual approval"
        },
        "trust_tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Trust tier (0=anonymous to 4=fully autonomous) for plugin execution"
        }
      }
    },
    "entry_points": {
      "type": "object",
      "description": "Runtime entry point locations",
      "properties": {
        "main": {
          "type": "string",
          "description": "Main plugin module entry point (e.g., 'my_plugin:define_plugin')"
        },
        "runtime": {
          "type": "string",
          "description": "Lazy-loaded runtime module with heavy logic (e.g., 'my_plugin.runtime:*')"
        },
        "setup": {
          "type": "string",
          "description": "Optional setup wizard entry point (e.g., 'my_plugin.setup:wizard')"
        }
      }
    },
    "enabled_by_default": {
      "type": "boolean",
      "default": false,
      "description": "Enable plugin by default on fresh AICP installation"
    },
    "legacy_plugin_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Previous plugin IDs for backward compatibility and migration"
    }
  },
  "additionalProperties": false
}
