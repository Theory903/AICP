{
  "id": "checkout_flow",
  "name": "checkout_flow",
  "description": "E-commerce checkout with conditionals",
  "steps": [
    {
      "id": "validate_cart",
      "capability_name": "cart.validate",
      "arguments": {},
      "on_success": "inventory_check"
    },
    {
      "id": "inventory_check",
      "capability_name": "inventory.check",
      "arguments": {},
      "on_failure": "notify_out_of_stock"
    },
    {
      "id": "authorize_payment",
      "capability_name": "payments.authorize",
      "arguments": {},
      "on_failure": "payment_failed"
    },
    {
      "id": "create_order",
      "capability_name": "orders.create",
      "arguments": {},
      "on_success": "schedule_shipping"
    },
    {
      "id": "schedule_shipping",
      "capability_name": "shipping.schedule",
      "arguments": {},
      "on_complete": "notify_order_confirmed"
    }
  ]
}
