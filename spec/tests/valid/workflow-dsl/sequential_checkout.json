{
  "name": "checkout_flow",
  "description": "Sequential checkout: add item, confirm order, charge payment",
  "version": "1.0.0",
  "steps": [
    {
      "id": "add_item",
      "type": "capability",
      "capability_name": "cart.add_item",
      "arguments": {"item_id": "pizza_001", "quantity": 1}
    },
    {
      "id": "confirm_order",
      "type": "approval",
      "capability_name": "order.confirm",
      "approval_policy": {"required": true, "role": "user"},
      "on_approved": "charge_payment",
      "on_rejected": "cancel_step"
    },
    {
      "id": "charge_payment",
      "type": "capability",
      "capability_name": "payments.charge",
      "input_mapping": {"order_id": "context.order_id"},
      "output_mapping": {"charge_id": "steps.charge_payment.charge_id"},
      "retry_policy": {"max_attempts": 3, "backoff": "exponential", "delay_ms": 500}
    },
    {
      "id": "cancel_step",
      "type": "terminal"
    }
  ],
  "on_failure": "cancel_step"
}
