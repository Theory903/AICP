{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/session.json",
  "title": "AICP Session",
  "description": "Resumable execution context with state, memory, trust tier, and approval history. Sessions persist across process restarts and span multiple capability executions.",
  "type": "object",
  "required": ["id", "status", "trust_tier", "created_at", "updated_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique session identifier (e.g. sess_abc123)"
    },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "completed", "expired", "cancelled"],
      "description": "Lifecycle state of the session"
    },
    "trust_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Trust level: 0=anonymous, 1=authenticated, 2=verified, 3=trusted, 4=fully_autonomous"
    },
    "agent_id": {
      "type": "string",
      "description": "Identifier of the agent that owns this session"
    },
    "user_id": {
      "type": "string",
      "description": "Optional human user this session is acting on behalf of"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the session was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last state change"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the session expires (null = no expiry)"
    },
    "goal": {
      "type": "string",
      "description": "Natural language description of the session's top-level goal"
    },
    "context": {
      "type": "object",
      "description": "Arbitrary key-value context carried through the session (e.g. user prefs, locale, active entity IDs)",
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "description": "5-layer memory system snapshot for this session",
      "properties": {
        "working": {
          "type": "object",
          "description": "In-flight data for the current task (cleared on session end)",
          "additionalProperties": true
        },
        "episodic": {
          "type": "array",
          "description": "Log of key events, decisions, and observations in this session",
          "items": {
            "type": "object",
            "required": ["event", "timestamp"],
            "properties": {
              "event": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "data": {}
            }
          }
        },
        "semantic": {
          "type": "object",
          "description": "Extracted facts and entities known about the domain (persistent across sessions)",
          "additionalProperties": true
        },
        "procedural": {
          "type": "array",
          "description": "Learned workflow patterns and skill sequences",
          "items": {
            "type": "object",
            "required": ["pattern"],
            "properties": {
              "pattern": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "meta": {
          "type": "object",
          "description": "Self-model: token budget, capability coverage, preference weights",
          "properties": {
            "token_budget_remaining": { "type": "integer", "minimum": 0 },
            "capability_coverage": {
              "type": "array",
              "items": { "type": "string" }
            },
            "preference_weights": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            }
          }
        }
      }
    },
    "active_workflow_id": {
      "type": "string",
      "description": "ID of the workflow currently executing in this session, if any"
    },
    "pending_approval_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of approval requests currently awaiting resolution in this session"
    },
    "execution_history": {
      "type": "array",
      "description": "Ordered list of execution IDs produced in this session",
      "items": { "type": "string" }
    },
    "allowed_next_actions": {
      "type": "array",
      "description": "Planner-suggested next actions given current session state",
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["capability", "workflow_step", "approval", "session_action"]
          },
          "name": { "type": "string" },
          "reason": { "type": "string" },
          "requires_approval": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "planner_output": {
      "type": "object",
      "description": "Most recent AI Planner output associated with this session",
      "properties": {
        "goal": { "type": "string" },
        "plan_id": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step_id", "capability_name"],
            "properties": {
              "step_id": { "type": "string" },
              "capability_name": { "type": "string" },
              "arguments": { "type": "object" },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rationale": { "type": "string" }
            }
          }
        },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "judge_verdict": {
      "type": "object",
      "description": "Most recent AI Judge evaluation of the session's plan or execution",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["approved", "rejected", "needs_revision", "partial"]
        },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" },
        "evaluated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "additionalProperties": false
}
