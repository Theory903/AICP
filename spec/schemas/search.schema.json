{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.ai/schemas/search.schema.json",
  "title": "Search",
  "description": "Web search configuration for multi-provider search",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": ["brave", "duckduckgo", "exa", "tavily", "searxng"],
      "default": "brave"
    },
    "num_results": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 50
    },
    "safe_search": {
      "type": "boolean",
      "default": true
    }
  }
}
