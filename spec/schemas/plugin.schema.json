{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/plugin.json",
  "title": "AICP Plugin Manifest",
  "description": "Manifest contract for discoverable AICP plugins.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "author",
    "plugin_type",
    "hooks",
    "capabilities",
    "dependencies",
    "config_schema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "plugin_type": {
      "type": "string",
      "enum": ["channel", "provider", "tool", "skill", "transport"]
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pre_capability",
          "post_capability",
          "pre_workflow",
          "post_workflow",
          "on_startup",
          "on_shutdown"
        ]
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
          },
          "version": {
            "type": "string"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "config_schema": {
      "type": "object"
    },
    "entry_point": {
      "type": "string",
      "default": "plugin.py"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "enabled_by_default": {
      "type": "boolean",
      "default": true
    },
    "bundled": {
      "type": "boolean",
      "default": false
    }
  }
}
